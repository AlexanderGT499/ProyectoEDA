  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 3ba4675811e63144b920f5067c7cc438, type: 3}
    m_FontSize: 32
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 230
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<size=45><b>\u2694\uFE0F BIENVENIDO/A A DUNGEON OF DECISIONS \u2694\uFE0F</b></size>\r\n<size=25><i>(Modo
    Competitivo 1 vs 1)</i></size>\r\n\r\n<size=24><color=#FFA500><i>\"Elige sabiamente
    tus decisiones para no morir en el camino...\"</i></color></size>\r\n\r\n<b><color=yellow>\U0001F4DC
    REGLAS DEL TORNEO:</color></b>\r\n1. <b>Turnos:</b> Primero juega el <b>JUGADOR
    1</b>. Al terminar, ser\xE1 el turno del <b>JUGADOR 2</b>.\r\n2. <b>Roguelike:</b>
    \xA1El Dungeon cambia siempre! Nunca sabr\xE1s qu\xE9 enemigo te toca.\r\n\r\n<b><color=red>\U0001F480
    SOBREVIVENCIA:</color></b>\r\n\u2022 <b>\u2694\uFE0F Atacar:</b> Ganas ORO pero
    pierdes vida.\r\n\u2022 <b>\U0001F3C3 Huir:</b> Avanzas, pero recibes <b>-35
    de DA\xD1O</b> por la espalda.\r\n\u2022 <b>\U0001F409 Drag\xF3n:</b> No se puede
    huir. Es matar o morir.\r\n\r\n<b><color=green>\U0001F3C6 \xBFC\xD3MO GANAR?</color></b>\r\nQuien
    termine la aventura con <b>M\xC1S VIDA</b> ser\xE1 el campe\xF3n."
